import funkin.modding.module.Module;
import funkin.play.PlayState;
import funkin.Conductor;
import funkin.util.FileUtil;

class FruitFlyModule extends Module {
	var SENSE_PATH:String = "mods/fruit-fly/python/fly_fnf_sense.txt";
	var BAT_PATH:String = "mods/fruit-fly/python/fly_brain.bat";
	var SH_PATH:String = "mods/fruit-fly/python/fly_brain.sh";
	var CMD_PATH:String = "mods/fruit-fly/python/fly_brain.command";
	var TICK:Float = 0.016;
	var IDLE_TICK:Float = 0.25;
	var SPAWN_GAP:Float = 5;
	var STALL_LIMIT:Int = 8;

	var clock:Float = 0;
	var spawnWait:Float = 0;
	var seq:Int = 0;
	var rating:String = "";
	var lastPos:Float = -1;
	var stalled:Int = 99;
	var etas:Array<Dynamic> = [null, null, null, null];
	var due:Array<Bool> = [false, false, false, false];
	var sustain:Array<Bool> = [false, false, false, false];
	var playing:Bool = false;

	public function new(?moduleId:String) {
		super(moduleId == null ? "FruitFlyModule" : moduleId, 50);
	}

	public override function onCreate(event:Dynamic):Void {
		relax();
	}

	public override function onSongStart(event:Dynamic):Void {
		playing = true;
		spawnWait = 0;
		spawnBrain();
	}

	public override function onSongRetry(event:Dynamic):Void {
		playing = true;
		spawnWait = 0;
		spawnBrain();
	}

	public override function onCountdownStart(event:Dynamic):Void {
		playing = true;
		spawnWait = 0;
		spawnBrain();
	}

	public override function onSongEnd(event:Dynamic):Void {
		playing = false;
		clearLanes();
		write(false, 0, 0);
	}

	public override function onDestroy(event:Dynamic):Void {
		playing = false;
		clearLanes();
		write(false, 0, 0);
	}

	public override function onUpdate(event:Dynamic):Void {
		relax();
		var dt:Float = 0.016;
		try {
			if (event != null && event.elapsed > 0 && event.elapsed < 1)
				dt = event.elapsed;
		} catch (e:Dynamic) {}
		clock = clock + dt;
		if (spawnWait > 0)
			spawnWait = spawnWait - dt;

		var line = playerLine();
		var pos = songPos();
		if (line != null) {
			if (pos == lastPos)
				stalled = stalled + 1;
			else {
				stalled = 0;
				lastPos = pos;
			}
			if (stalled > STALL_LIMIT)
				line = null;
		}

		if (line == null) {
			playing = false;
			if (clock < IDLE_TICK)
				return;
			clock = 0;
			clearLanes();
			write(false, 0, 0);
			return;
		}

		playing = true;
		spawnBrain();
		if (clock < TICK)
			return;
		clock = 0;
		scan(line, pos);
		write(true, pos, comboCount());
	}

	public override function onNoteHit(event:Dynamic):Void {
		try {
			if (event.note != null && event.note.isHoldNote)
				return;
			var judgement = event.judgement;
			if (judgement == null)
				return;
			if (judgement == "perfect" && event.score == 0)
				return;
			rating = Std.string(judgement);
		} catch (e:Dynamic) {}
	}

	public override function onNoteMiss(event:Dynamic):Void {
		rating = "miss";
	}

	function relax() {
		try {
			if (FlxG.autoPause)
				FlxG.autoPause = false;
		} catch (e:Dynamic) {}
	}

	function spawnBrain() {
		if (!playing || spawnWait > 0)
			return;
		if (pressAlive())
			return;
		spawnWait = SPAWN_GAP;
	}

	function pressAlive():Bool {
		try {
			if (!FileUtil.fileExists(SENSE_PATH.split("sense").join("press")))
				return false;
			var text = FileUtil.readStringFromPath("mods/fruit-fly/python/fly_fnf_press.txt");
			if (text == null)
				return false;
			return text.indexOf("alive=1") >= 0 && text.indexOf("quit=1") < 0;
		} catch (e:Dynamic) {}
		return false;
	}

	function playerLine():Dynamic {
		try {
			var state = PlayState.instance;
			if (state == null)
				return null;
			var line = state.playerStrumline;
			if (line == null || line.notes == null)
				return null;
			return line;
		} catch (e:Dynamic) {}
		return null;
	}

	function songPos():Float {
		try {
			return Conductor.instance.songPosition;
		} catch (e:Dynamic) {}
		return 0;
	}

	function comboCount():Int {
		try {
			return Std.int(PlayState.instance.combo);
		} catch (e:Dynamic) {}
		return 0;
	}

	function clearLanes() {
		var i = 0;
		while (i < 4) {
			etas[i] = null;
			due[i] = false;
			sustain[i] = false;
			i = i + 1;
		}
	}

	function scan(line:Dynamic, pos:Float) {
		clearLanes();
		var notes = null;
		try {
			notes = line.notes.members;
		} catch (e:Dynamic) {}
		if (notes == null)
			return;
		var count = 0;
		try {
			count = notes.length;
		} catch (e:Dynamic) {}
		var i = 0;
		while (i < count) {
			var note = notes[i];
			i = i + 1;
			if (note == null)
				continue;
			var lane = -1;
			var t = 0.0;
			var hit = false;
			var missed = false;
			var may = false;
			var hold = false;
			try {
				lane = Std.int(note.direction);
				t = note.strumTime;
				hit = note.hasBeenHit == true;
				missed = note.hasMissed == true;
				may = note.mayHit == true;
				hold = note.isHoldNote == true;
			} catch (e:Dynamic) {
				continue;
			}
			if (lane < 0 || lane > 3 || hit || missed)
				continue;
			if (skipNote(note))
				continue;
			var eta = (t - pos) * 0.001;
			if (eta > -0.12 && eta < 0.32) {
				if (etas[lane] == null || Math.abs(eta) < Math.abs(etas[lane]))
					etas[lane] = eta;
			}
			if (may)
				due[lane] = true;
			if (hold) {
				sustain[lane] = true;
				due[lane] = true;
			}
		}
	}

	function write(song:Bool, pos:Float, combo:Int) {
		seq = seq + 1;
		var text = "v=1 song=" + (song ? "1" : "0") + " t=" + pos + " combo=" + combo + " seq=" + seq + " keys=1 layout=arrows\n";
		text = text + "e=" + num(etas[0]) + "," + num(etas[1]) + "," + num(etas[2]) + "," + num(etas[3]) + "\n";
		text = text + "s=" + bit(sustain[0]) + "," + bit(sustain[1]) + "," + bit(sustain[2]) + "," + bit(sustain[3]) + "\n";
		text = text + "d=" + bit(due[0]) + "," + bit(due[1]) + "," + bit(due[2]) + "," + bit(due[3]) + "\n";
		if (rating != "") {
			text = text + "r=" + rating + "\n";
			rating = "";
		}
		try {
			FileUtil.deleteFile(SENSE_PATH);
		} catch (e:Dynamic) {}
		try {
			FileUtil.writeStringToPath(SENSE_PATH, text);
		} catch (e:Dynamic) {}
	}

	function num(v:Dynamic):String {
		if (v == null)
			return "";
		return Std.string(v);
	}

	function bit(v:Dynamic):String {
		return v == true ? "1" : "0";
	}

	function badType(raw:Dynamic):Bool {
		if (raw == null)
			return false;
		var t = Std.string(raw).toLowerCase();
		if (t == "" || t == "null" || t == "normal" || t == "default" || t == "none")
			return false;
		var keys = ["hurt", "mine", "kill", "death", "fake", "bomb", "hazard", "black", "evil", "insta", "spike", "trap", "poison", "shadow", "void", "blood", "nohit", "no-hit", "ghost", "thorn", "danger"];
		var i = 0;
		while (i < keys.length) {
			if (t.indexOf(keys[i]) >= 0)
				return true;
			i = i + 1;
		}
		return false;
	}

	function darkColor(note:Dynamic):Bool {
		try {
			var n = Std.int(note.color);
			var r = (n >> 16) & 255;
			var g = (n >> 8) & 255;
			var b = n & 255;
			return r < 48 && g < 48 && b < 48 && (r + g + b) < 90;
		} catch (e:Dynamic) {}
		return false;
	}

	function skipNote(note:Dynamic):Bool {
		if (note == null)
			return true;
		try {
			if (note.avoid == true)
				return true;
		} catch (e:Dynamic) {}
		try {
			if (note.hitCausesMiss == true)
				return true;
		} catch (e:Dynamic) {}
		try {
			if (note.ignoreNote == true)
				return true;
		} catch (e:Dynamic) {}
		try {
			if (note.blockHit == true)
				return true;
		} catch (e:Dynamic) {}
		try {
			if (note.hurtNote == true)
				return true;
		} catch (e:Dynamic) {}
		try {
			if (badType(note.noteType))
				return true;
		} catch (e:Dynamic) {}
		try {
			if (badType(note.noteKind))
				return true;
		} catch (e:Dynamic) {}
		try {
			if (badType(note.kind))
				return true;
		} catch (e:Dynamic) {}
		if (darkColor(note))
			return true;
		return false;
	}
}
